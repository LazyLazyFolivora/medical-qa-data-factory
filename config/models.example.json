{
  "default_provider": "local-no-auth",
  "providers": {
    "local-no-auth": {
      "driver": "openai_compatible",
      "base_url": "http://127.0.0.1:8000/v1/chat/completions",
      "model_id": "your-local-model",
      "auth_mode": "none",
      "structured_output_mode": "json_object",
      "structured_output_modes_by_role": {},
      "tokenization_url": null,
      "supports_strict_json_schema": false,
      "timeout_seconds": 120,
      "max_retries": 3,
      "context_window_tokens": 32768,
      "output_reserve_tokens": 4096,
      "context_safety_tokens": 1024,
      "compact_trigger_ratio": 0.85,
      "compact_target_ratio": 0.75
    },
    "strict-with-key": {
      "driver": "openai_compatible",
      "base_url": "https://your-endpoint.example/v1/chat/completions",
      "model_id": "your-structured-model",
      "auth_mode": "bearer",
      "api_key_env": "MEDICAL_QA_MODEL_API_KEY",
      "structured_output_mode": "json_schema",
      "supports_strict_json_schema": true,
      "timeout_seconds": 120,
      "max_retries": 3,
      "context_window_tokens": 32768,
      "output_reserve_tokens": 4096,
      "context_safety_tokens": 1024,
      "compact_trigger_ratio": 0.85,
      "compact_target_ratio": 0.75
    },
    "deepseek-official": {
      "driver": "openai_compatible",
      "base_url": "https://api.deepseek.com/chat/completions",
      "model_id": "deepseek-v4-pro",
      "auth_mode": "bearer",
      "api_key_env": "DEEPSEEK_API_KEY",
      "structured_output_mode": "json_object",
      "supports_strict_json_schema": false,
      "structured_output_modes_by_role": {},
      "tokenization_url": null,
      "timeout_seconds": 180,
      "max_retries": 3,
      "request_parameters": {
        "reasoning_effort": "none"
      },
      "context_window_tokens": 1000000,
      "output_reserve_tokens": 4096,
      "context_safety_tokens": 1024,
      "compact_trigger_ratio": 0.85,
      "compact_target_ratio": 0.75
    }
  }
}
