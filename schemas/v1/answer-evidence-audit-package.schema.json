{
  "$defs": {
    "AnswerCardinality": {
      "enum": [
        "EXACTLY_ONE",
        "ONE_OR_MORE",
        "EXACT_SET"
      ],
      "title": "AnswerCardinality",
      "type": "string"
    },
    "AnswerResolution": {
      "additionalProperties": false,
      "properties": {
        "answer_cardinality": {
          "$ref": "#/$defs/AnswerCardinality"
        },
        "blind_answer_query_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Blind Answer Query Digest",
          "type": "string"
        },
        "competing_answers_checked": {
          "title": "Competing Answers Checked",
          "type": "boolean"
        },
        "completeness_basis": {
          "$ref": "#/$defs/CompletenessBasis"
        },
        "conflict_checked": {
          "title": "Conflict Checked",
          "type": "boolean"
        },
        "contradicting_anchor_ids": {
          "items": {
            "type": "string"
          },
          "title": "Contradicting Anchor Ids",
          "type": "array"
        },
        "hypothesis_id": {
          "minLength": 1,
          "title": "Hypothesis Id",
          "type": "string"
        },
        "public_scope": {
          "minLength": 1,
          "title": "Public Scope",
          "type": "string"
        },
        "resolution_id": {
          "minLength": 1,
          "title": "Resolution Id",
          "type": "string"
        },
        "schema_version": {
          "default": "objective-question-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AnswerStatus"
        },
        "supporting_anchor_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Anchor Ids",
          "type": "array"
        },
        "verification_coverage_report_id": {
          "minLength": 1,
          "title": "Verification Coverage Report Id",
          "type": "string"
        },
        "verification_plan_id": {
          "minLength": 1,
          "title": "Verification Plan Id",
          "type": "string"
        },
        "verification_policy_version": {
          "minLength": 1,
          "title": "Verification Policy Version",
          "type": "string"
        },
        "verification_sources": {
          "items": {
            "type": "string"
          },
          "title": "Verification Sources",
          "type": "array"
        },
        "verified_answer_values": {
          "items": {
            "type": "string"
          },
          "title": "Verified Answer Values",
          "type": "array"
        }
      },
      "required": [
        "resolution_id",
        "hypothesis_id",
        "status",
        "answer_cardinality",
        "public_scope",
        "competing_answers_checked",
        "conflict_checked",
        "completeness_basis",
        "verification_policy_version",
        "blind_answer_query_digest",
        "verification_plan_id",
        "verification_coverage_report_id"
      ],
      "title": "AnswerResolution",
      "type": "object"
    },
    "AnswerStatus": {
      "enum": [
        "VERIFIED",
        "REJECTED",
        "INDETERMINATE"
      ],
      "title": "AnswerStatus",
      "type": "string"
    },
    "CompletenessBasis": {
      "enum": [
        "CANONICAL_IDENTITY",
        "AUTHORITATIVE_DEFINITION",
        "AUTHORITATIVE_ENUMERATION",
        "EXPLICIT_PUBLIC_OPTIONS",
        "DETERMINISTIC_CALCULATION",
        "NOT_ESTABLISHED"
      ],
      "title": "CompletenessBasis",
      "type": "string"
    },
    "FrozenQuestionContract": {
      "additionalProperties": false,
      "properties": {
        "allowed_wording_constraints": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Wording Constraints",
          "type": "array"
        },
        "answer_cardinality": {
          "$ref": "#/$defs/AnswerCardinality"
        },
        "answer_type": {
          "minLength": 1,
          "title": "Answer Type",
          "type": "string"
        },
        "answer_values": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Answer Values",
          "type": "array"
        },
        "claim_strength": {
          "minLength": 1,
          "title": "Claim Strength",
          "type": "string"
        },
        "contract_id": {
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        },
        "forbidden_semantic_upgrades": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden Semantic Upgrades",
          "type": "array"
        },
        "public_scope": {
          "minLength": 1,
          "title": "Public Scope",
          "type": "string"
        },
        "question_intent": {
          "minLength": 1,
          "title": "Question Intent",
          "type": "string"
        },
        "required_public_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Required Public Conditions",
          "type": "array"
        },
        "resolution_id": {
          "minLength": 1,
          "title": "Resolution Id",
          "type": "string"
        },
        "schema_version": {
          "default": "objective-question-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "question_intent",
        "public_scope",
        "answer_type",
        "answer_values",
        "answer_cardinality",
        "claim_strength",
        "resolution_id"
      ],
      "title": "FrozenQuestionContract",
      "type": "object"
    },
    "IndependentEvidenceAuditPackage": {
      "additionalProperties": false,
      "properties": {
        "anchors": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "minItems": 1,
          "title": "Anchors",
          "type": "array"
        },
        "evidence_used": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Used",
          "type": "array"
        }
      },
      "required": [
        "evidence_used",
        "anchors"
      ],
      "title": "IndependentEvidenceAuditPackage",
      "type": "object"
    },
    "PublicQuestionPackage": {
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        },
        "question_text": {
          "minLength": 1,
          "title": "Question Text",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "question_text"
      ],
      "title": "PublicQuestionPackage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer_resolution": {
      "$ref": "#/$defs/AnswerResolution"
    },
    "frozen_question_contract": {
      "$ref": "#/$defs/FrozenQuestionContract"
    },
    "independent_evidence": {
      "$ref": "#/$defs/IndependentEvidenceAuditPackage"
    },
    "question": {
      "$ref": "#/$defs/PublicQuestionPackage"
    }
  },
  "required": [
    "question",
    "frozen_question_contract",
    "answer_resolution",
    "independent_evidence"
  ],
  "title": "AnswerEvidenceAuditPackage",
  "type": "object"
}
