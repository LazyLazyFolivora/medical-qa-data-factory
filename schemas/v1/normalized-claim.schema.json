{
  "additionalProperties": false,
  "description": "A source-neutral semantic claim with explicit evidence roles.",
  "properties": {
    "claim_id": {
      "minLength": 1,
      "title": "Claim Id",
      "type": "string"
    },
    "claim_text": {
      "default": "",
      "title": "Claim Text",
      "type": "string"
    },
    "context_evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Context Evidence Ids",
      "type": "array"
    },
    "contradicting_evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Contradicting Evidence Ids",
      "type": "array"
    },
    "legacy_claim_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Legacy Claim Id"
    },
    "normalizer_version": {
      "minLength": 1,
      "title": "Normalizer Version",
      "type": "string"
    },
    "object_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Object Id"
    },
    "object_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Object Value"
    },
    "polarity": {
      "default": "unknown",
      "enum": [
        "increase",
        "decrease",
        "neutral",
        "unknown"
      ],
      "title": "Polarity",
      "type": "string"
    },
    "predicate_family": {
      "minLength": 1,
      "title": "Predicate Family",
      "type": "string"
    },
    "qualifiers": {
      "additionalProperties": true,
      "title": "Qualifiers",
      "type": "object"
    },
    "schema_version": {
      "const": "source-neutral-evidence-v1",
      "default": "source-neutral-evidence-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "subject_id": {
      "minLength": 1,
      "title": "Subject Id",
      "type": "string"
    },
    "supporting_evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Supporting Evidence Ids",
      "type": "array"
    }
  },
  "required": [
    "claim_id",
    "subject_id",
    "predicate_family",
    "normalizer_version"
  ],
  "title": "NormalizedClaim",
  "type": "object"
}
