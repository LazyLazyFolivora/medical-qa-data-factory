{
  "$defs": {
    "ArtifactEnvelope": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "payload"
      ],
      "title": "ArtifactEnvelope",
      "type": "object"
    },
    "ChildResultSlot": {
      "additionalProperties": false,
      "properties": {
        "aggregated_commit_sequence": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregated Commit Sequence"
        },
        "artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "parent_decision_id": {
          "minLength": 1,
          "title": "Parent Decision Id",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/SubagentResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "slot_id": {
          "minLength": 1,
          "title": "Slot Id",
          "type": "string"
        },
        "state": {
          "default": "OPEN",
          "enum": [
            "OPEN",
            "COMMITTED"
          ],
          "title": "State",
          "type": "string"
        },
        "subtask_revision": {
          "minimum": 0,
          "title": "Subtask Revision",
          "type": "integer"
        }
      },
      "required": [
        "slot_id",
        "parent_decision_id",
        "subtask_revision"
      ],
      "title": "ChildResultSlot",
      "type": "object"
    },
    "DeduplicationStatus": {
      "enum": [
        "IN_FLIGHT",
        "COMMITTED",
        "RETRYABLE_FAILED",
        "UNKNOWN",
        "TERMINAL_FAILED"
      ],
      "title": "DeduplicationStatus",
      "type": "string"
    },
    "DomainOutcome": {
      "enum": [
        "SUPPORTED",
        "CONFLICT",
        "INSUFFICIENT",
        "NOT_APPLICABLE"
      ],
      "title": "DomainOutcome",
      "type": "string"
    },
    "ExecutionStatus": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "UNKNOWN"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "HypothesisState": {
      "enum": [
        "PROPOSED",
        "VERIFICATION_PLANNED",
        "VERIFYING",
        "ANSWER_VERIFIED",
        "QUESTION_REALIZED",
        "RELEASE_REVIEWED",
        "PUBLISHED",
        "REJECTED",
        "INDETERMINATE"
      ],
      "title": "HypothesisState",
      "type": "string"
    },
    "OperationRecord": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "commit_sequence": {
          "minimum": 0,
          "title": "Commit Sequence",
          "type": "integer"
        },
        "cost": {
          "default": 0.0,
          "minimum": 0,
          "title": "Cost",
          "type": "number"
        },
        "deduplication_status": {
          "$ref": "#/$defs/DeduplicationStatus"
        },
        "domain_outcome": {
          "$ref": "#/$defs/DomainOutcome"
        },
        "error_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Category"
        },
        "execution_status": {
          "$ref": "#/$defs/ExecutionStatus"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finished At"
        },
        "input_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Digest",
          "type": "string"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "operation_key": {
          "minLength": 1,
          "title": "Operation Key",
          "type": "string"
        },
        "operation_type": {
          "minLength": 1,
          "title": "Operation Type",
          "type": "string"
        },
        "output_artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Output Artifact Ids",
          "type": "array"
        },
        "parent_subtask_id": {
          "minLength": 1,
          "title": "Parent Subtask Id",
          "type": "string"
        },
        "retry_ordinal": {
          "minimum": 0,
          "title": "Retry Ordinal",
          "type": "integer"
        },
        "schema_version": {
          "default": "objective-question-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "usage": {
          "additionalProperties": true,
          "title": "Usage",
          "type": "object"
        },
        "verdict": {
          "$ref": "#/$defs/VerificationVerdict"
        }
      },
      "required": [
        "operation_key",
        "attempt_id",
        "retry_ordinal",
        "parent_subtask_id",
        "operation_type",
        "input_digest",
        "started_at",
        "finished_at",
        "deduplication_status",
        "commit_sequence",
        "execution_status",
        "domain_outcome",
        "verdict"
      ],
      "title": "OperationRecord",
      "type": "object"
    },
    "RunManifest": {
      "additionalProperties": false,
      "properties": {
        "data_snapshot_or_retrieval_time_policy": {
          "minLength": 1,
          "title": "Data Snapshot Or Retrieval Time Policy",
          "type": "string"
        },
        "main_agent_version": {
          "minLength": 1,
          "title": "Main Agent Version",
          "type": "string"
        },
        "manifest_id": {
          "minLength": 1,
          "title": "Manifest Id",
          "type": "string"
        },
        "model_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Model Versions",
          "type": "object"
        },
        "orchestrator_version": {
          "minLength": 1,
          "title": "Orchestrator Version",
          "type": "string"
        },
        "prompt_digests": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Prompt Digests",
          "type": "object"
        },
        "provider_adapter_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Provider Adapter Versions",
          "type": "object"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "runtime_bundle_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Runtime Bundle Digest",
          "type": "string"
        },
        "runtime_bundle_id": {
          "minLength": 1,
          "title": "Runtime Bundle Id",
          "type": "string"
        },
        "schema_version": {
          "default": "objective-question-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "schema_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Schema Versions",
          "type": "object"
        },
        "skill_digests": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Skill Digests",
          "type": "object"
        },
        "subagent_role_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Subagent Role Versions",
          "type": "object"
        },
        "tool_contract_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Tool Contract Versions",
          "type": "object"
        },
        "validation_policy_version": {
          "minLength": 1,
          "title": "Validation Policy Version",
          "type": "string"
        }
      },
      "required": [
        "manifest_id",
        "run_id",
        "orchestrator_version",
        "main_agent_version",
        "subagent_role_versions",
        "model_versions",
        "schema_versions",
        "validation_policy_version",
        "data_snapshot_or_retrieval_time_policy",
        "runtime_bundle_id",
        "runtime_bundle_digest"
      ],
      "title": "RunManifest",
      "type": "object"
    },
    "RunState": {
      "enum": [
        "CREATED",
        "MATERIALS_COLLECTED",
        "CLAIMS_PROPOSED",
        "HYPOTHESES_PROPOSED",
        "CANDIDATES_PROCESSING",
        "COMPLETED",
        "COMPLETED_WITH_ZERO_QUESTIONS",
        "PROVIDER_FAILED",
        "RECOVERY_REQUIRED",
        "VERSION_INCOMPATIBLE",
        "CANCELLED"
      ],
      "title": "RunState",
      "type": "string"
    },
    "RuntimeBudget": {
      "additionalProperties": false,
      "properties": {
        "charged_cost": {
          "default": 0.0,
          "minimum": 0,
          "title": "Charged Cost",
          "type": "number"
        },
        "max_cost": {
          "exclusiveMinimum": 0,
          "title": "Max Cost",
          "type": "number"
        },
        "max_model_calls": {
          "minimum": 1,
          "title": "Max Model Calls",
          "type": "integer"
        },
        "used_model_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Used Model Calls",
          "type": "integer"
        }
      },
      "required": [
        "max_cost",
        "max_model_calls"
      ],
      "title": "RuntimeBudget",
      "type": "object"
    },
    "SubagentResult": {
      "additionalProperties": false,
      "properties": {
        "domain_outcome": {
          "$ref": "#/$defs/DomainOutcome"
        },
        "error_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Category"
        },
        "evidence_need_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Need Ids",
          "type": "array"
        },
        "execution_status": {
          "$ref": "#/$defs/ExecutionStatus"
        },
        "output_artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Output Artifact Ids",
          "type": "array"
        },
        "schema_version": {
          "default": "objective-question-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "stop_reason": {
          "minLength": 1,
          "title": "Stop Reason",
          "type": "string"
        },
        "subtask_id": {
          "minLength": 1,
          "title": "Subtask Id",
          "type": "string"
        },
        "usage": {
          "additionalProperties": true,
          "title": "Usage",
          "type": "object"
        },
        "verdict": {
          "$ref": "#/$defs/VerificationVerdict"
        }
      },
      "required": [
        "subtask_id",
        "execution_status",
        "domain_outcome",
        "verdict",
        "stop_reason"
      ],
      "title": "SubagentResult",
      "type": "object"
    },
    "VerificationVerdict": {
      "enum": [
        "VERIFIED",
        "REJECTED",
        "INDETERMINATE",
        "NOT_EMITTED"
      ],
      "title": "VerificationVerdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aggregation_commits": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Aggregation Commits",
      "type": "object"
    },
    "artifacts": {
      "additionalProperties": {
        "$ref": "#/$defs/ArtifactEnvelope"
      },
      "title": "Artifacts",
      "type": "object"
    },
    "budget": {
      "$ref": "#/$defs/RuntimeBudget"
    },
    "child_slots": {
      "additionalProperties": {
        "$ref": "#/$defs/ChildResultSlot"
      },
      "title": "Child Slots",
      "type": "object"
    },
    "commit_sequence": {
      "minimum": 0,
      "title": "Commit Sequence",
      "type": "integer"
    },
    "hypotheses": {
      "additionalProperties": {
        "$ref": "#/$defs/HypothesisState"
      },
      "title": "Hypotheses",
      "type": "object"
    },
    "manifest": {
      "$ref": "#/$defs/RunManifest"
    },
    "operations": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/OperationRecord"
        },
        "type": "array"
      },
      "title": "Operations",
      "type": "object"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "run_state": {
      "$ref": "#/$defs/RunState",
      "default": "CREATED"
    },
    "schema_version": {
      "default": "objective-runtime-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "state_revision": {
      "minimum": 0,
      "title": "State Revision",
      "type": "integer"
    },
    "stop_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    }
  },
  "required": [
    "run_id",
    "manifest",
    "state_revision",
    "commit_sequence",
    "budget"
  ],
  "title": "ObjectiveRuntimeSnapshot",
  "type": "object"
}
