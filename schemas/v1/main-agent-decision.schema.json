{
  "additionalProperties": false,
  "properties": {
    "action": {
      "minLength": 1,
      "title": "Action",
      "type": "string"
    },
    "decision_id": {
      "minLength": 1,
      "title": "Decision Id",
      "type": "string"
    },
    "expected_information_gain": {
      "maximum": 1,
      "minimum": 0,
      "title": "Expected Information Gain",
      "type": "number"
    },
    "input_artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Input Artifact Ids",
      "type": "array"
    },
    "requested_budget": {
      "additionalProperties": true,
      "title": "Requested Budget",
      "type": "object"
    },
    "schema_version": {
      "default": "objective-question-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "state_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "State Digest",
      "type": "string"
    },
    "stop_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    },
    "target_subagent_role": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Subagent Role"
    }
  },
  "required": [
    "decision_id",
    "action",
    "state_digest",
    "expected_information_gain"
  ],
  "title": "MainAgentDecision",
  "type": "object"
}
