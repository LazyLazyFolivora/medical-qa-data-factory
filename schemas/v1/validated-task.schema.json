{
  "$defs": {
    "AcceptableEvidenceSet": {
      "additionalProperties": false,
      "description": "A source-neutral Boolean completion alternative.",
      "properties": {
        "all_of": {
          "items": {
            "type": "string"
          },
          "title": "All Of",
          "type": "array"
        },
        "any_of": {
          "items": {
            "type": "string"
          },
          "title": "Any Of",
          "type": "array"
        }
      },
      "title": "AcceptableEvidenceSet",
      "type": "object"
    },
    "Aggregation": {
      "description": "How the answer set is aggregated.",
      "enum": [
        "none",
        "count",
        "exists",
        "set"
      ],
      "title": "Aggregation",
      "type": "string"
    },
    "AnswerContract": {
      "additionalProperties": false,
      "description": "The normalized answer and its declared cardinality.",
      "properties": {
        "accepted_aliases": {
          "items": {
            "type": "string"
          },
          "title": "Accepted Aliases",
          "type": "array"
        },
        "answer_type": {
          "enum": [
            "entity",
            "entity_set",
            "scalar",
            "categorical"
          ],
          "title": "Answer Type",
          "type": "string"
        },
        "canonical_answer_ids": {
          "items": {
            "type": "string"
          },
          "title": "Canonical Answer Ids",
          "type": "array"
        },
        "cardinality": {
          "enum": [
            "exactly_one",
            "one_or_more",
            "exact_set"
          ],
          "title": "Cardinality",
          "type": "string"
        },
        "normalization_rule": {
          "default": "canonical identity match",
          "title": "Normalization Rule",
          "type": "string"
        },
        "scope_statement": {
          "minLength": 1,
          "title": "Scope Statement",
          "type": "string"
        }
      },
      "required": [
        "answer_type",
        "cardinality",
        "scope_statement"
      ],
      "title": "AnswerContract",
      "type": "object"
    },
    "ClaimPattern": {
      "additionalProperties": false,
      "description": "Source-neutral semantic condition needed to complete a task.",
      "properties": {
        "object_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Id"
        },
        "object_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Value"
        },
        "predicate_family": {
          "minLength": 1,
          "title": "Predicate Family",
          "type": "string"
        },
        "qualifier_constraints": {
          "additionalProperties": true,
          "title": "Qualifier Constraints",
          "type": "object"
        },
        "subject_id": {
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "predicate_family"
      ],
      "title": "ClaimPattern",
      "type": "object"
    },
    "CompletionRule": {
      "additionalProperties": false,
      "description": "Deterministic rule for deciding whether a task is complete.",
      "properties": {
        "mode": {
          "const": "any_acceptable_set_satisfied",
          "default": "any_acceptable_set_satisfied",
          "title": "Mode",
          "type": "string"
        },
        "require_answer_contract_match": {
          "const": true,
          "default": true,
          "title": "Require Answer Contract Match",
          "type": "boolean"
        },
        "require_complete_validation": {
          "const": true,
          "default": true,
          "title": "Require Complete Validation",
          "type": "boolean"
        }
      },
      "title": "CompletionRule",
      "type": "object"
    },
    "InformationRequirement": {
      "additionalProperties": false,
      "description": "Information that must be established, independent of a tool route.",
      "properties": {
        "claim_pattern": {
          "$ref": "#/$defs/ClaimPattern"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_quality_rule": {
          "default": "structured_or_supported_literature",
          "title": "Evidence Quality Rule",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "requirement_id": {
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        },
        "weight": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "requirement_id",
        "description",
        "claim_pattern"
      ],
      "title": "InformationRequirement",
      "type": "object"
    },
    "LogicalDirection": {
      "description": "How a step is walked.",
      "enum": [
        "forward",
        "reverse"
      ],
      "title": "LogicalDirection",
      "type": "string"
    },
    "LogicalQuery": {
      "additionalProperties": false,
      "description": "An ordered, typed multi-hop query with a named answer variable.",
      "properties": {
        "aggregation": {
          "$ref": "#/$defs/Aggregation",
          "default": "none"
        },
        "answer_entity_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer Entity Type"
        },
        "answer_variable": {
          "default": "answer",
          "minLength": 1,
          "title": "Answer Variable",
          "type": "string"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/QueryConstraint"
          },
          "title": "Constraints",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "dependency_digest": {
          "minLength": 1,
          "title": "Dependency Digest",
          "type": "string"
        },
        "expected_cardinality": {
          "default": "any",
          "pattern": "^(one|many|any)$",
          "title": "Expected Cardinality",
          "type": "string"
        },
        "filters": {
          "additionalProperties": true,
          "title": "Filters",
          "type": "object"
        },
        "negation": {
          "default": false,
          "title": "Negation",
          "type": "boolean"
        },
        "path_id": {
          "minLength": 1,
          "title": "Path Id",
          "type": "string"
        },
        "path_version": {
          "minLength": 1,
          "title": "Path Version",
          "type": "string"
        },
        "probe_digest": {
          "minLength": 1,
          "title": "Probe Digest",
          "type": "string"
        },
        "probe_id": {
          "minLength": 1,
          "title": "Probe Id",
          "type": "string"
        },
        "query_id": {
          "minLength": 1,
          "title": "Query Id",
          "type": "string"
        },
        "schema_version": {
          "default": "logical-query-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "start_entity_id": {
          "minLength": 1,
          "title": "Start Entity Id",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/QueryStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "temporal_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temporal Scope"
        }
      },
      "required": [
        "query_id",
        "path_id",
        "path_version",
        "probe_id",
        "probe_digest",
        "start_entity_id",
        "steps",
        "snapshot_id",
        "dependency_digest",
        "created_at"
      ],
      "title": "LogicalQuery",
      "type": "object"
    },
    "ProviderSnapshotRef": {
      "additionalProperties": false,
      "description": "One immutable provider snapshot used by a validation environment.",
      "properties": {
        "completeness": {
          "minLength": 1,
          "title": "Completeness",
          "type": "string"
        },
        "detail": {
          "additionalProperties": true,
          "title": "Detail",
          "type": "object"
        },
        "manifest_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Hash"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Version"
        },
        "snapshot_id": {
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "snapshot_id",
        "completeness"
      ],
      "title": "ProviderSnapshotRef",
      "type": "object"
    },
    "QueryConstraint": {
      "additionalProperties": false,
      "description": "A path predicate that an answer candidate must satisfy.\n\nConstraints start from the answer variable and end at a fixed entity. They\nexpress intersections such as \"targeted by Drug A\" AND \"associated with\nDisease D\" without pinning the candidate answer itself.",
      "properties": {
        "constraint_id": {
          "minLength": 1,
          "title": "Constraint Id",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/QueryStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "terminal_entity_id": {
          "minLength": 1,
          "title": "Terminal Entity Id",
          "type": "string"
        }
      },
      "required": [
        "constraint_id",
        "steps",
        "terminal_entity_id"
      ],
      "title": "QueryConstraint",
      "type": "object"
    },
    "QueryStep": {
      "additionalProperties": false,
      "description": "One typed hop of a logical query.",
      "properties": {
        "direction": {
          "$ref": "#/$defs/LogicalDirection"
        },
        "from_entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Entity Id"
        },
        "position": {
          "minimum": 0,
          "title": "Position",
          "type": "integer"
        },
        "relation": {
          "minLength": 1,
          "title": "Relation",
          "type": "string"
        },
        "target_entity_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Entity Type"
        },
        "to_entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Entity Id"
        }
      },
      "required": [
        "position",
        "relation",
        "direction"
      ],
      "title": "QueryStep",
      "type": "object"
    },
    "StudyContext": {
      "additionalProperties": false,
      "description": "Biomedical qualifiers that must be visible in the public question.",
      "properties": {
        "additional_qualifiers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Additional Qualifiers",
          "type": "object"
        },
        "disease_category": {
          "minLength": 1,
          "title": "Disease Category",
          "type": "string"
        },
        "dose_or_regimen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dose Or Regimen"
        },
        "exposure_context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exposure Context"
        },
        "exposure_duration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exposure Duration"
        },
        "polarity": {
          "default": "unknown",
          "enum": [
            "increase",
            "decrease",
            "neutral",
            "unknown"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "population": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population"
        },
        "relation_intent": {
          "enum": [
            "association_research",
            "biomarker_research",
            "therapeutic_research",
            "risk_increase",
            "risk_decrease",
            "safety"
          ],
          "title": "Relation Intent",
          "type": "string"
        },
        "sample_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Type"
        },
        "study_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Study Type"
        },
        "temporal_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temporal Scope"
        }
      },
      "required": [
        "disease_category",
        "relation_intent"
      ],
      "title": "StudyContext",
      "type": "object"
    },
    "TaskSpec": {
      "additionalProperties": false,
      "description": "A compiled task awaiting authoritative validation.",
      "properties": {
        "acceptable_evidence_sets": {
          "items": {
            "$ref": "#/$defs/AcceptableEvidenceSet"
          },
          "minItems": 1,
          "title": "Acceptable Evidence Sets",
          "type": "array"
        },
        "candidate_claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Candidate Claim Ids",
          "type": "array"
        },
        "candidate_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Candidate Evidence Ids",
          "type": "array"
        },
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "completion_rule": {
          "$ref": "#/$defs/CompletionRule"
        },
        "generator_version": {
          "default": "unknown",
          "title": "Generator Version",
          "type": "string"
        },
        "information_requirements": {
          "items": {
            "$ref": "#/$defs/InformationRequirement"
          },
          "minItems": 1,
          "title": "Information Requirements",
          "type": "array"
        },
        "proposed_answer_contract": {
          "$ref": "#/$defs/AnswerContract"
        },
        "public_entity_names": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Public Entity Names",
          "type": "object"
        },
        "public_study_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/StudyContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "query": {
          "$ref": "#/$defs/LogicalQuery"
        },
        "question_type": {
          "enum": [
            "single_relation_entity",
            "constrained_entity",
            "hidden_bridge_two_hop",
            "explicit_bridge_two_hop",
            "study_context_qualified_disease",
            "ctd_direct_evidence_disease",
            "primekg_ctd_pubmed_therapeutic_research_disease",
            "primekg_ctd_pubmed_marker_mechanism",
            "primekg_ctd_pubmed_association"
          ],
          "title": "Question Type",
          "type": "string"
        },
        "schema_version": {
          "default": "task-construction-v2",
          "title": "Schema Version",
          "type": "string"
        },
        "seed_entity_id": {
          "minLength": 1,
          "title": "Seed Entity Id",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "validation_environment": {
          "$ref": "#/$defs/ValidationEnvironment"
        }
      },
      "required": [
        "task_id",
        "candidate_id",
        "seed_entity_id",
        "question_type",
        "query",
        "proposed_answer_contract",
        "information_requirements",
        "acceptable_evidence_sets",
        "validation_environment"
      ],
      "title": "TaskSpec",
      "type": "object"
    },
    "ValidationEnvironment": {
      "additionalProperties": false,
      "description": "The replayable world in which answers and cardinality are certified.",
      "properties": {
        "completeness_scope": {
          "minLength": 1,
          "title": "Completeness Scope",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "environment_id": {
          "minLength": 1,
          "title": "Environment Id",
          "type": "string"
        },
        "providers": {
          "items": {
            "$ref": "#/$defs/ProviderSnapshotRef"
          },
          "minItems": 1,
          "title": "Providers",
          "type": "array"
        },
        "schema_version": {
          "default": "task-construction-v2",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "environment_id",
        "providers",
        "completeness_scope"
      ],
      "title": "ValidationEnvironment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A task whose answer and semantics were certified by a validator.",
  "properties": {
    "answer_contract": {
      "$ref": "#/$defs/AnswerContract"
    },
    "gold_claim_ids": {
      "items": {
        "type": "string"
      },
      "title": "Gold Claim Ids",
      "type": "array"
    },
    "gold_evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Gold Evidence Ids",
      "type": "array"
    },
    "schema_version": {
      "default": "task-construction-v2",
      "title": "Schema Version",
      "type": "string"
    },
    "task": {
      "$ref": "#/$defs/TaskSpec"
    },
    "validated_at": {
      "format": "date-time",
      "title": "Validated At",
      "type": "string"
    },
    "validation_report_id": {
      "minLength": 1,
      "title": "Validation Report Id",
      "type": "string"
    }
  },
  "required": [
    "task",
    "answer_contract",
    "validation_report_id",
    "validated_at"
  ],
  "title": "ValidatedTask",
  "type": "object"
}
