{
  "$defs": {
    "AnswerCardinality": {
      "enum": [
        "EXACTLY_ONE",
        "ONE_OR_MORE",
        "EXACT_SET"
      ],
      "title": "AnswerCardinality",
      "type": "string"
    },
    "FactSelectionNote": {
      "additionalProperties": false,
      "properties": {
        "additional_fact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Additional Fact"
        },
        "candidate_claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Candidate Claim Ids",
          "type": "array"
        },
        "composition": {
          "enum": [
            "single",
            "connected",
            "insufficient"
          ],
          "title": "Composition",
          "type": "string"
        },
        "information_gain": {
          "title": "Information Gain",
          "type": "string"
        },
        "observation": {
          "title": "Observation",
          "type": "string"
        }
      },
      "required": [
        "candidate_claim_ids",
        "observation",
        "information_gain",
        "composition"
      ],
      "title": "FactSelectionNote",
      "type": "object"
    },
    "QuestionHypothesis": {
      "additionalProperties": false,
      "properties": {
        "candidate_claim_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Candidate Claim Ids",
          "type": "array"
        },
        "discovery_anchor_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Discovery Anchor Ids",
          "type": "array"
        },
        "hypothesis_id": {
          "minLength": 1,
          "title": "Hypothesis Id",
          "type": "string"
        },
        "proposed_answer_type": {
          "minLength": 1,
          "title": "Proposed Answer Type",
          "type": "string"
        },
        "proposed_answer_values": {
          "items": {
            "type": "string"
          },
          "title": "Proposed Answer Values",
          "type": "array"
        },
        "proposed_cardinality": {
          "$ref": "#/$defs/AnswerCardinality"
        },
        "proposed_difficulty": {
          "anyOf": [
            {
              "enum": [
                "easy",
                "medium",
                "hard"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Difficulty"
        },
        "proposed_public_scope": {
          "minLength": 1,
          "title": "Proposed Public Scope",
          "type": "string"
        },
        "question_intent": {
          "minLength": 1,
          "title": "Question Intent",
          "type": "string"
        },
        "risk_flags": {
          "items": {
            "type": "string"
          },
          "title": "Risk Flags",
          "type": "array"
        },
        "schema_version": {
          "default": "objective-question-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "PROPOSED",
          "default": "PROPOSED",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "hypothesis_id",
        "candidate_claim_ids",
        "question_intent",
        "proposed_public_scope",
        "proposed_answer_type",
        "proposed_cardinality",
        "discovery_anchor_ids"
      ],
      "title": "QuestionHypothesis",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "fact_selections": {
      "items": {
        "$ref": "#/$defs/FactSelectionNote"
      },
      "title": "Fact Selections",
      "type": "array"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/QuestionHypothesis"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "insufficiency_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Insufficiency Reason"
    }
  },
  "title": "QuestionHypothesisBatch",
  "type": "object"
}
