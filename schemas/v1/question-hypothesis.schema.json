{
  "$defs": {
    "AnswerCardinality": {
      "enum": [
        "EXACTLY_ONE",
        "ONE_OR_MORE",
        "EXACT_SET"
      ],
      "title": "AnswerCardinality",
      "type": "string"
    },
    "SuggestedRetrieval": {
      "additionalProperties": false,
      "properties": {
        "expected_evidence": {
          "minLength": 1,
          "title": "Expected Evidence",
          "type": "string"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "schema_version": {
          "default": "objective-question-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "stop_condition": {
          "minLength": 1,
          "title": "Stop Condition",
          "type": "string"
        }
      },
      "required": [
        "query",
        "sources",
        "expected_evidence",
        "stop_condition"
      ],
      "title": "SuggestedRetrieval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_claim_ids": {
      "items": {
        "type": "string"
      },
      "title": "Candidate Claim Ids",
      "type": "array"
    },
    "discovery_anchor_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Discovery Anchor Ids",
      "type": "array"
    },
    "evidence_basis": {
      "default": "claims",
      "enum": [
        "claims",
        "source_passages"
      ],
      "title": "Evidence Basis",
      "type": "string"
    },
    "hypothesis_id": {
      "minLength": 1,
      "title": "Hypothesis Id",
      "type": "string"
    },
    "proposed_answer_type": {
      "minLength": 1,
      "title": "Proposed Answer Type",
      "type": "string"
    },
    "proposed_answer_values": {
      "items": {
        "type": "string"
      },
      "title": "Proposed Answer Values",
      "type": "array"
    },
    "proposed_cardinality": {
      "$ref": "#/$defs/AnswerCardinality"
    },
    "proposed_difficulty": {
      "anyOf": [
        {
          "enum": [
            "easy",
            "medium",
            "hard"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposed Difficulty"
    },
    "proposed_public_scope": {
      "minLength": 1,
      "title": "Proposed Public Scope",
      "type": "string"
    },
    "question_intent": {
      "minLength": 1,
      "title": "Question Intent",
      "type": "string"
    },
    "risk_flags": {
      "items": {
        "type": "string"
      },
      "title": "Risk Flags",
      "type": "array"
    },
    "schema_version": {
      "default": "objective-question-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "const": "PROPOSED",
      "default": "PROPOSED",
      "title": "Status",
      "type": "string"
    },
    "suggested_retrieval": {
      "anyOf": [
        {
          "$ref": "#/$defs/SuggestedRetrieval"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "hypothesis_id",
    "question_intent",
    "proposed_public_scope",
    "proposed_answer_type",
    "proposed_cardinality",
    "discovery_anchor_ids"
  ],
  "title": "QuestionHypothesis",
  "type": "object"
}
