{
  "$defs": {
    "CompletenessBasis": {
      "enum": [
        "CANONICAL_IDENTITY",
        "AUTHORITATIVE_DEFINITION",
        "AUTHORITATIVE_ENUMERATION",
        "EXPLICIT_PUBLIC_OPTIONS",
        "DETERMINISTIC_CALCULATION",
        "NOT_ESTABLISHED"
      ],
      "title": "CompletenessBasis",
      "type": "string"
    },
    "CoverageStatus": {
      "enum": [
        "COMPLETE",
        "INCOMPLETE"
      ],
      "title": "CoverageStatus",
      "type": "string"
    },
    "EvidenceAnchor": {
      "additionalProperties": false,
      "properties": {
        "anchor_id": {
          "minLength": 1,
          "title": "Anchor Id",
          "type": "string"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "end_offset": {
          "exclusiveMinimum": 0,
          "title": "End Offset",
          "type": "integer"
        },
        "material_id": {
          "minLength": 1,
          "title": "Material Id",
          "type": "string"
        },
        "quote_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Quote Hash",
          "type": "string"
        },
        "quoted_text": {
          "minLength": 1,
          "title": "Quoted Text",
          "type": "string"
        },
        "schema_version": {
          "default": "objective-question-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "section_or_field": {
          "minLength": 1,
          "title": "Section Or Field",
          "type": "string"
        },
        "start_offset": {
          "minimum": 0,
          "title": "Start Offset",
          "type": "integer"
        }
      },
      "required": [
        "anchor_id",
        "material_id",
        "document_id",
        "section_or_field",
        "start_offset",
        "end_offset",
        "quoted_text",
        "quote_hash"
      ],
      "title": "EvidenceAnchor",
      "type": "object"
    },
    "ProviderTerminalStatus": {
      "enum": [
        "SUCCEEDED",
        "EMPTY",
        "FAILED",
        "UNKNOWN"
      ],
      "title": "ProviderTerminalStatus",
      "type": "string"
    },
    "VerificationAttempt": {
      "additionalProperties": false,
      "properties": {
        "anchor_ids": {
          "items": {
            "type": "string"
          },
          "title": "Anchor Ids",
          "type": "array"
        },
        "attempt_id": {
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "error_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Category"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "material_ids": {
          "items": {
            "type": "string"
          },
          "title": "Material Ids",
          "type": "array"
        },
        "plan_id": {
          "minLength": 1,
          "title": "Plan Id",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "schema_version": {
          "default": "objective-question-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "terminal_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderTerminalStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "attempt_id",
        "plan_id",
        "query",
        "provider_id",
        "started_at"
      ],
      "title": "VerificationAttempt",
      "type": "object"
    },
    "VerificationCoverageReport": {
      "additionalProperties": false,
      "properties": {
        "budget_exhausted": {
          "title": "Budget Exhausted",
          "type": "boolean"
        },
        "competing_answer_queries": {
          "minimum": 0,
          "title": "Competing Answer Queries",
          "type": "integer"
        },
        "contradiction_queries": {
          "minimum": 0,
          "title": "Contradiction Queries",
          "type": "integer"
        },
        "coverage_report_id": {
          "minLength": 1,
          "title": "Coverage Report Id",
          "type": "string"
        },
        "coverage_status": {
          "$ref": "#/$defs/CoverageStatus"
        },
        "expected_attempt_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Expected Attempt Ids",
          "type": "array"
        },
        "failed_attempt_ids": {
          "items": {
            "type": "string"
          },
          "title": "Failed Attempt Ids",
          "type": "array"
        },
        "schema_version": {
          "default": "objective-question-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "successful_attempt_ids": {
          "items": {
            "type": "string"
          },
          "title": "Successful Attempt Ids",
          "type": "array"
        },
        "terminal_attempt_ids": {
          "items": {
            "type": "string"
          },
          "title": "Terminal Attempt Ids",
          "type": "array"
        },
        "unknown_attempt_ids": {
          "items": {
            "type": "string"
          },
          "title": "Unknown Attempt Ids",
          "type": "array"
        }
      },
      "required": [
        "coverage_report_id",
        "expected_attempt_ids",
        "budget_exhausted",
        "competing_answer_queries",
        "contradiction_queries",
        "coverage_status"
      ],
      "title": "VerificationCoverageReport",
      "type": "object"
    },
    "VerificationPlan": {
      "additionalProperties": false,
      "properties": {
        "allowed_provider_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Provider Ids",
          "type": "array"
        },
        "blind_answer_query_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Blind Answer Query Digest",
          "type": "string"
        },
        "budget": {
          "additionalProperties": true,
          "minProperties": 1,
          "title": "Budget",
          "type": "object"
        },
        "competing_answer_strategy": {
          "minLength": 1,
          "title": "Competing Answer Strategy",
          "type": "string"
        },
        "contradiction_strategy": {
          "minLength": 1,
          "title": "Contradiction Strategy",
          "type": "string"
        },
        "expected_attempt_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Expected Attempt Ids",
          "type": "array"
        },
        "hypothesis_id": {
          "minLength": 1,
          "title": "Hypothesis Id",
          "type": "string"
        },
        "plan_id": {
          "minLength": 1,
          "title": "Plan Id",
          "type": "string"
        },
        "schema_version": {
          "default": "objective-question-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "stop_conditions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Stop Conditions",
          "type": "array"
        }
      },
      "required": [
        "plan_id",
        "hypothesis_id",
        "blind_answer_query_digest",
        "expected_attempt_ids",
        "allowed_provider_ids",
        "competing_answer_strategy",
        "contradiction_strategy",
        "budget",
        "stop_conditions"
      ],
      "title": "VerificationPlan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "anchors": {
      "items": {
        "$ref": "#/$defs/EvidenceAnchor"
      },
      "minItems": 1,
      "title": "Anchors",
      "type": "array"
    },
    "attempts": {
      "items": {
        "$ref": "#/$defs/VerificationAttempt"
      },
      "minItems": 1,
      "title": "Attempts",
      "type": "array"
    },
    "completeness_basis": {
      "$ref": "#/$defs/CompletenessBasis"
    },
    "contradicting_anchor_ids": {
      "items": {
        "type": "string"
      },
      "title": "Contradicting Anchor Ids",
      "type": "array"
    },
    "coverage": {
      "$ref": "#/$defs/VerificationCoverageReport"
    },
    "plan": {
      "$ref": "#/$defs/VerificationPlan"
    },
    "supporting_anchor_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Supporting Anchor Ids",
      "type": "array"
    }
  },
  "required": [
    "plan",
    "attempts",
    "coverage",
    "anchors",
    "supporting_anchor_ids",
    "completeness_basis"
  ],
  "title": "VerificationEvidenceBundle",
  "type": "object"
}
